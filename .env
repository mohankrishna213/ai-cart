# Database settings
MYSQL_DATABASE=product_catalog
MYSQL_ROOT_PASSWORD=root

# Spring Boot datasource (points to service name 'db')
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/product_catalog?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
