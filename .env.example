# Database settings
MYSQL_DATABASE=product_catalog
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# Spring Boot datasource (points to service name 'db')
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/product_catalog?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# OAuth2 (Google Login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_redis_password

# Google AI Studio - Chat (Gemma 4)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key
GOOGLE_GENAI_EMBEDDING_API_KEY=your_google_genai_embedding_api_key

# Local development (non-docker)
LOCAL_DATASOURCE_URL=jdbc:mysql://localhost:3306/product_catalog?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
LOCAL_DATASOURCE_USERNAME=root
LOCAL_DATASOURCE_PASSWORD=your_local_mysql_password
LOCAL_REDIS_HOST=localhost

# GitHub Webhook Relay (for SRE Diagnostic Agent)
# Fine-grained PAT with Contents: Read-only on the repo
GITHUB_TOKEN=ghp_your_personal_access_token_here